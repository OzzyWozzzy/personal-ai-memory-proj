# Local files are loaded in this order: process environment, .env.local, .env.
MEMORY_LOAD_LOCAL_ENV=1

# Optional external Postgres. When unset, pgserver boots an isolated local DB.
POSTGRES_ADMIN_URL=
POSTGRES_APP_URL=

# Local HTTP boundary.
MEMORY_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MEMORY_ALLOWED_ORIGINS=http://localhost:8321,http://127.0.0.1:8321,http://testserver
MEMORY_MAX_REQUEST_BYTES=2097152
MEMORY_ENABLE_LOCAL_PREVIEW=1

# Graph extraction. Replay is deterministic and offline but requires a matching
# committed fixture. Use openai or anthropic for new, previously unseen text.
MEMORY_GRAPHITI_LLM=replay
MEMORY_GRAPHITI_MODEL=
MEMORY_GRAPHITI_SMALL_MODEL=
MEMORY_FIXTURES_DIR=fixtures/graphiti
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# FalkorDB. When unset, falkordblite boots under MEMORY_GRAPH_DIR.
MEMORY_FALKORDB_URL=
MEMORY_GRAPH_DIR=.falkordb
FASTEMBED_CACHE_PATH=
GRAPHITI_TELEMETRY_ENABLED=false

# Retrieval tuning.
MEMORY_SEARCH_LIMIT=30
MEMORY_RAW_EPISODE_SCAN_LIMIT=1000
MEMORY_RAW_RERANK_POOL=80
MEMORY_RAW_FINAL_CAP=10
MEMORY_RAW_PER_SOURCE=5
